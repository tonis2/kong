{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  // Libraries to use for all targets.
  "dependencies": ["vk", "c3w", "image", "shady"],
  // Authors, optionally with email.
  "authors": [ "Tonis" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**", "lib/shady.c3l/test/**" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "kong": {
      "type": "executable"
    }
  },
  "cpu": "generic",
  "opt": "O0"
}