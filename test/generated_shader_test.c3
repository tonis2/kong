<*
 Shaders generated by three.c3's `ShaderDef`, compiled here.

 three.c3 writes a whole shady module from its wire structs
 (`src/shader/def.c3`) and, being the generator, is the wrong place to decide
 whether the text is a module. Its suite writes what it generated to
 `build/shaderdef/*.shady`, and this is where that text is asked the question
 kong can answer: compile, then validate against the Vulkan environment.

 Every module is compiled the way the engine compiles it, `scalar_layout: true`
 (C3's packing), because the structs in a generated module are C3's wire structs
 and std430 would silently stride them differently - `SkinnedVertex` by 32
 instead of 24.

 Missing files are skipped with a message rather than failed: kong has to build
 and test on its own, and three.c3 may not have run.
*>
module generated_shader_test;

import std::core::test;
import std::io;
import std::io::file;
import std::io::path;
import std::os::process;
import shady;

const String GENERATED_DIR = "../three.c3/build/shaderdef";

// One name per shader three.c3 generates. Adding a port adds a name here.
const String[*] GENERATED = { "sky", "skin", "cluster", "shadow", "shadow_cutout", "mesh", "mesh_lit", "post" };

fn void every_generated_module_compiles() @test
{
	foreach (name : GENERATED)
	{
		String path = string::tformat("%s/%s.shady", GENERATED_DIR, name);
		if (!file::is_file(path))
		{
			io::printfn("generated: no %s; skipped", path);
			continue;
		}

		char[]? bytes = file::load(tmem, path);
		if (catch bytes)
		{
			test::@check(false, "%s can be read", path);
			continue;
		}
		String source = (String)bytes;

		shady::Diagnostic diagnostic;
		char[]? spirv = shady::compile(source, &diagnostic, scalar_layout: true);
		if (catch spirv)
		{
			test::@check(false, "%s compiles: %s", name, diagnostic.to_string(tmem));
			diagnostic.free();
			continue;
		}
		diagnostic.free();

		test::@check(((uint*)spirv.ptr)[0] == shady::MAGIC, "%s has the SPIR-V magic", name);

		path::mkdir("build/generated", recursive: true)!!;
		String out = string::tformat("build/generated/%s.spv", name);
		file::save(out, spirv)!!;
		free(spirv);

		// The environment that matters is Vulkan's, not SPIR-V's: the generic
		// validator accepts things Vulkan rejects. `--scalar-block-layout` is
		// the feature the wire structs need - C3 packs `Instance`'s trailing
		// `float4` at offset 164, which std430 would not - and the device asks
		// for it the same way, so the module and its validator agree.
		int? status = process::run(
			{ "spirv-val", "--target-env", "vulkan1.3", "--scalar-block-layout", out }
		);
		if (catch status)
		{
			test::@check(false, "spirv-val could not run on %s", out);
		}
		else
		{
			test::@check(status == 0, "%s validates for Vulkan (spirv-val said %d)", name, status);
		}
	}
}
